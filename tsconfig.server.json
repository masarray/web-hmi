{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    "lib": [
      "ES2022"
    ],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "server/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
